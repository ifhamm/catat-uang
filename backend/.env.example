# --- Supabase -------------------------------------------------------------
# Direct or pooler connection string from Supabase: Database -> Connection string
DATABASE_URL=postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: if omitted, the project URL is derived from DATABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed for legacy projects that use a symmetric signing key.
# The asymmetric (JWKS) path is used automatically when available.
SUPABASE_PUBLISHABLE_KEY=

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Server ----------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Comma-separated allowlist of frontend origins allowed to call the API.
CORS_ORIGIN=https://<your-pages-domain>.pages.dev
